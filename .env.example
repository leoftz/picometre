# Copy to .env.local (git-ignored) and fill in. Never commit real values.
# Local dev: use the values printed by `supabase status` (local Docker stack).

# Supabase API URL (public)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key sb_publishable_… (public by design — data is protected by RLS)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SECRET — server only (bypasses RLS). Never prefix with NEXT_PUBLIC_, never import in client code.
SUPABASE_SECRET_KEY=
# Public base URL of the app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Sign-in by magic link (needs a dedicated SMTP in production, see docs/mise-en-ligne.md). Keep "true" locally:
# the E2E tests sign in through Mailpit. Leave unset on Vercel until the SMTP is ready.
NEXT_PUBLIC_MAGIC_LINK=true
